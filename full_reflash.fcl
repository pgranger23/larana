      SpaceCharge: {
         CalibrationInputFilename: "SCEoffsets.root"
         EnableCalEfieldSCE: false
         EnableCalSpatialSCE: false
         EnableCorrSCE: false
         EnableSimEfieldSCE: false
         EnableSimSpatialSCE: false
         InputFilename: "SCEoffsets.root"
         RepresentationType: "Parametric"
         service_provider: "SpaceChargeServiceStandard"
         service_type: "SpaceCharge"
      }
      WireReadout: {
         ChannelsPerOpDet: 1
         service_provider: "DUNEWireReadout"
         service_type: "WireReadout"
      }
      scheduler: {
         errorOnMissingConsumes: false
         errorOnSIGINT: true
         num_schedules: 1
         num_threads: 1
         pruneConfig: true
         reportUnused: true
      }

}

source: {
  module_type: RootInput
  maxEvents: -1
}

physics: {
  producers: {
    # parameters identical to the production 'opflash' module
    opflashre: {
      module_type:    "OpFlashFinder"
      InputModule:    "ophitspe"
      BinWidth:        1
      FlashThreshold:  3.5
      WidthTolerance:  0.5
      TrigCoinc:       2.5
    }
  }
  reco:          [ opflashre ]
  trigger_paths: [ reco ]
  stream:        [ out1 ]
  end_paths:     [ stream ]
}

outputs: {
  out1: {
    module_type: RootOutput
    fileName:    "reflash.root"
    dataTier:    "full-reconstructed"
    streamName:  "out1"
    # Exactly the products the pds extractor reads, plus the re-run flashes. The
    # optical waveforms (OpWaveforms 1637 MB + OpDetWaveforms 302 MB of a 2291 MB file)
    # are 85% of the size and are not needed once OpHits exist, so the intermediate
    # drops from ~2.2 GB to ~110 MB per file.
    outputCommands: [ "drop *",
                      "keep simb::MCTruths_generator__GenieGen*",
                      "keep simb::MCParticles_largeant__G4*",
                      "keep sim::OpDetBacktrackerRecords_PDFastSim__G4*",
                      "keep recob::OpHits_ophitspe__Reco2*",
                      "keep recob::SpacePoints_pandora__Reco2*",
                      "keep recob::SpacePoints_reco3d__Reco2*",
                      "keep recob::Vertexs_pandora__Reco2*",
                      "keep recob::OpFlashs_opflash__Reco2*",
                      "keep *_opflashre_*_ReOpFlash" ]
  }
}
