# Re-run the production OpFlashFinder on an existing reco file.
#
# Services are lifted VERBATIM from the production Reco2 process
# (config_dumper -P <reco file> -> services block), pruned to the set OpFlashFinder
# actually needs: geometry, wire readout, detector clocks/properties. The DUNE
# raw-digit services are dropped -- they need a top-level `tools` block that is not
# part of the services dump and they play no role here.
#
# Purpose: reproduce the ~2.7% of events (flat in energy) where no OpFlash is made
# despite the ophitspe collection carrying >10^5 PE at that time.

process_name: ReOpFlash

services: {
      AuxDetGeometry: {
         GDML: "dune10kt_v6_refactored_1x2x6.gdml"
         Name: "dune10kt_v6_1x2x6"
         SortingParameters: {
            tool_type: "AuxDetGeoObjectSorterYZX"
         }
         service_type: "AuxDetGeometry"
      }
      DetectorClocksService: {
         ClockSpeedExternal: 3.125e1
         ClockSpeedOptical: 6.25e1
         ClockSpeedTPC: 2
         ClockSpeedTrigger: 16
         DefaultBeamTime: 0
         DefaultTrigTime: 0
